{
  "manifest_version": 3,
  "name": "카피바라 4세",
  "version": "1.6.0",
  "minimum_chrome_version": "111",
  "key": "",
  "description": "기존 카피바라 북마클릿을 코코포리아에서 자동 실행합니다. 개인용 로컬 설치 전용입니다.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://ccfolia.com/*", "http://127.0.0.1:8787/*", "https://capybara-iv.for-trpg.workers.dev/*"],
  "icons": { "128": "icon.png" },
  "action": {
    "default_title": "웹 공유 설정 (코코포리아에서 사용)",
    "default_icon": "icon.png"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://ccfolia.com/*"],
    "js": ["bootstrap.js", "relay-page.js"],
    "run_at": "document_idle",
    "world": "MAIN",
    "all_frames": false
  }, {
    "matches": ["https://ccfolia.com/*"],
    "js": ["relay-bridge.js", "home-bookmarks.js"],
    "run_at": "document_idle",
    "world": "ISOLATED",
    "all_frames": false
  }, {
    "matches": ["https://capybara-iv.for-trpg.workers.dev/*", "http://127.0.0.1:8787/*"],
    "js": ["relay-marker.js"],
    "run_at": "document_start",
    "world": "ISOLATED",
    "all_frames": false
  }]
}
