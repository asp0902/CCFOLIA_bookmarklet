// DRAFT - not published. Firebase project: ccfolia-handout-25c6b (the handout tool's own project, anonymous sign-in).
// It replaces the rules that are published now (see firebase/README.md for what they allow and why they have to change). Publish it only after the handout tool that writes
// inbox copies is released (handout-overhaul stage 2), otherwise the tool that is in use today stops syncing.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function gmDoc(roomId) { return get(/databases/$(database)/documents/rooms/$(roomId)/meta/gm); }
    // the GM of a room: the account that wrote meta/gm (the room's owner in CCFOLIA, decided by the handout tool on the owner's side)
    function isGm(roomId) { return signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/meta/gm) && gmDoc(roomId).data.gmUid == request.auth.uid; }

    match /rooms/{roomId} {
      // GM marker: anybody signed in reads it; the first writer creates it; afterwards only the current GM changes it - or the same CCFOLIA account on another browser
      // (its anonymous uid changed): the new document must carry the gmCcfoliaUid the old one has. That claim is made by a client, so it is only as good as the secrecy of the owner's
      // CCFOLIA uid (a participant can read it in members/meta only if they are the GM; it is not published to players).
      // The claim cannot be a field: a merge update that leaves the field alone would look like a claim. So the proof is a path: the claimant first creates
      // claims/{gmCcfoliaUid}_{their uid}, which the rules allow only for the account uid the seat holds, and the takeover needs that document to exist.
      match /meta/gm {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.gmUid == request.auth.uid;
        allow update: if signedIn() && request.resource.data.gmUid == request.auth.uid
          && (resource.data.gmUid == request.auth.uid
            || (resource.data.get('gmCcfoliaUid', '') != '' && resource.data.gmCcfoliaUid == request.resource.data.get('gmCcfoliaUid', '')
              && exists(/databases/$(database)/documents/rooms/$(roomId)/claims/$(resource.data.gmCcfoliaUid + '_' + request.auth.uid))));
        allow delete: if isGm(roomId);
      }
      match /claims/{claimId} {
        allow create, update: if signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/meta/gm)
          && gmDoc(roomId).data.get('gmCcfoliaUid', '') != ''
          && claimId == gmDoc(roomId).data.gmCcfoliaUid + '_' + request.auth.uid;
      }
      // other meta documents (folders): everybody signed in reads, only the GM writes
      match /meta/{docId} {
        allow read: if signedIn();
        allow write: if docId != 'gm' && isGm(roomId);
      }

      // the originals, with the secret text: only the GM
      match /handouts/{handoutId} {
        allow read, write: if isGm(roomId);
      }
      // what one person may read: the GM writes it, the person reads their own (the document id is the person's anonymous uid)
      match /inbox/{uid}/handouts/{handoutId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if isGm(roomId);
      }
      // who is who: everybody writes only their own record (account uid and display name); the GM and the person read it
      match /members/{uid} {
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['ccfoliaUid', 'displayName', 'updatedAt'])
          && request.resource.data.ccfoliaUid is string && request.resource.data.ccfoliaUid.size() > 0 && request.resource.data.ccfoliaUid.size() <= 128
          && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80;
        allow read: if signedIn() && (request.auth.uid == uid || isGm(roomId));
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      // "show to players" signals: created by the GM, read by everybody signed in (they only name a handout id; what can be read stays in the inbox)
      match /shows/{showId} {
        allow read: if signedIn();
        allow create: if isGm(roomId) && request.resource.data.atUid == request.auth.uid;
        allow delete: if isGm(roomId);
      }
      // 사이코로픽션 시트(룸 공유 저장). sheets/{sheetId} = 비밀·사명을 뺀 시트 JSON(json), ownerUid(마지막으로 쓴 계정), updatedAt(ms), deleted(지움 표시). 읽기: 로그인한 누구나.
      // 쓰기: 룸 구성원(members/{내 uid} 가 있는 사람)이 ownerUid 를 자기 uid 로 적어 쓴다 - 소유권을 넘겨받는 것도 이 "신고"다(코코포리아 소유권은 서버가 검증할 수 없어 위조 가능, 핸드아웃 members 와 같은 신뢰 수준).
      // GM 은 모두 쓴다. 지우기는 GM 또는 현재 ownerUid.
      function isMember(roomId) { return signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/members/$(request.auth.uid)); }
      match /sheets/{sheetId} {
        allow read: if signedIn();
        allow create, update: if (isGm(roomId) || (isMember(roomId) && request.resource.data.ownerUid == request.auth.uid))
          && request.resource.data.keys().hasOnly(['json', 'ownerUid', 'updatedAt', 'deleted'])
          && request.resource.data.json is string && request.resource.data.json.size() <= 600000
          && request.resource.data.ownerUid is string && request.resource.data.updatedAt is number;
        allow delete: if isGm(roomId) || (signedIn() && resource.data.ownerUid == request.auth.uid);
      }
      // 비밀·사명: GM 과 그 시트의 현재 ownerUid 만 읽고 쓴다(소유권을 넘겨받으면 같은 묶음 쓰기로 sheets 의 ownerUid 가 먼저 바뀌므로 getAfter 로 본다).
      match /sheetSecrets/{sheetId} {
        allow read: if isGm(roomId) || (signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/sheets/$(sheetId)) && get(/databases/$(database)/documents/rooms/$(roomId)/sheets/$(sheetId)).data.ownerUid == request.auth.uid);
        allow create, update: if (isGm(roomId) || (signedIn() && getAfter(/databases/$(database)/documents/rooms/$(roomId)/sheets/$(sheetId)).data.ownerUid == request.auth.uid))
          && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
          && request.resource.data.json is string && request.resource.data.json.size() <= 200000 && request.resource.data.updatedAt is number;
        allow delete: if isGm(roomId) || (signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/sheets/$(sheetId)) && get(/databases/$(database)/documents/rooms/$(roomId)/sheets/$(sheetId)).data.ownerUid == request.auth.uid);
      }
      match /presence/{uid} {
        allow read: if signedIn();
        allow write, delete: if signedIn() && request.auth.uid == uid;
      }
      // pictures (split into chunks): handout pictures are the GM's, pictures pasted into the chat are anybody's own. A picture belongs to the account in its ownerUid; only that account (or the GM)
      // changes or deletes it. Reading needs a sign-in and the picture id (random, inside the text that shows it); the id is not listed anywhere because listing the pictures is not allowed.
      match /images/{imageId} {
        function ownsImage(id) { return signedIn() && exists(/databases/$(database)/documents/rooms/$(roomId)/images/$(id)) && get(/databases/$(database)/documents/rooms/$(roomId)/images/$(id)).data.get('ownerUid', '') == request.auth.uid; }
        allow get: if signedIn();
        allow list: if false;
        allow create: if isGm(roomId) || (signedIn() && request.resource.data.get('ownerUid', '') == request.auth.uid);
        allow update: if isGm(roomId) || (ownsImage(imageId) && request.resource.data.get('ownerUid', '') == request.auth.uid);
        allow delete: if isGm(roomId) || ownsImage(imageId);
        match /chunks/{chunkId} {
          allow get: if signedIn();
          allow list: if signedIn(); // the reader asks for the chunks of one known picture
          allow create, update, delete: if isGm(roomId) || ownsImage(imageId);
        }
      }
    }
  }
}
